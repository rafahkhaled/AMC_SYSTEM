# Production configuration, for the instance in me-central-1.
#
#   cp .env.production.example .env.production   # on the server, not here
#   chmod 600 .env.production
#
# Nothing in this file has a working default. That is deliberate: a system
# that falls back to a known key is worse than one that will not boot.

# ---- secrets, generated once -------------------------------------------
# openssl rand -base64 32
SECRET_ENCRYPTION_KEY=
# openssl rand -base64 24
POSTGRES_PASSWORD=
# openssl rand -base64 32 — keep a copy somewhere other than this server.
# A backup you cannot decrypt is not a backup.
BACKUP_PASSPHRASE=

# ---- the site ----------------------------------------------------------
# The domain Caddy gets a certificate for, and where Meta will send webhooks.
SITE_ADDRESS=amc.example.ae
ACME_EMAIL=admin@example.ae

# ---- documents ---------------------------------------------------------
# Production refuses 'local': a folder on the application server is not where
# a firm's client records belong.
STORAGE_DRIVER=s3
STORAGE_BUCKET=
STORAGE_REGION=me-central-1

# Where nightly dumps go. Without it, backup.sh writes to disk only, which
# means the backup dies with the instance it was protecting against.
S3_BACKUP_BUCKET=

# ---- the firm ----------------------------------------------------------
FIRM_NAME=Active Management Consultancy
FIRM_SIGNATORY=
FIRM_NAME_ARABIC=
BUSINESS_TIME_ZONE=Asia/Dubai
DEFAULT_CURRENCY=AED

# ---- billing -----------------------------------------------------------
# VAT in basis points. 500 is five percent; 0 if the firm is not registered.
BILLING_VAT_BASIS_POINTS=500
BILLING_PAYMENT_TERMS_DAYS=30
# What a client with no rate of their own is billed, in fils per hour. The
# floor under the arithmetic, so a missing rate bills at something visible.
BILLING_DEFAULT_RATE_MINOR=30000

# ---- email -------------------------------------------------------------
# A verified SES sender. Leave it empty and the worker writes emails to the
# log instead — a working system and a note, rather than a crash on the first
# escalation.
NOTIFICATION_FROM=
SES_REGION=me-central-1

# ---- WhatsApp ----------------------------------------------------------
# Leave the driver as 'log' until Meta approves the business account. It runs
# the whole path — matched, stored, answered, logged, queued, marked sent —
# and writes the last step to the log instead of to a phone.
#
# 'cloud' requires all four below and the API refuses to boot without them,
# because the alternative is a practice that believes WhatsApp is live while
# every reply fails somewhere nobody is looking.
WHATSAPP_DRIVER=log
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# ---- logging -----------------------------------------------------------
LOG_LEVEL=info
