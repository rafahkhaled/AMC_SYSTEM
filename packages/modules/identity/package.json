{
  "name": "@amc/identity",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/application/index.d.ts",
      "default": "./dist/application/index.js"
    },
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "default": "./dist/domain/index.js"
    },
    "./infrastructure": {
      "types": "./dist/infrastructure/index.d.ts",
      "default": "./dist/infrastructure/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@amc/kernel": "workspace:*",
    "@node-rs/argon2": "^2.2.1",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "ulid": "^3.0.2",
    "@amc/database": "workspace:*",
    "@amc/contracts": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "reflect-metadata": "^0.2.2",
    "@amc/http-kit": "workspace:*",
    "@amc/vault": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^3.2.4",
    "@types/express": "^5.0.0",
    "@nestjs/testing": "^12.0.1",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2"
  }
}
