{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    // Nest reads constructor parameter types at runtime to resolve dependencies.
    // verbatimModuleSyntax would erase type-only imports in a way that leaves
    // those metadata entries undefined, so it is off in this package.
    "verbatimModuleSyntax": false,
    "strictPropertyInitialization": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts"],
  "references": [
    { "path": "../../packages/kernel" },
    { "path": "../../packages/contracts" },
    { "path": "../../packages/database" },
    { "path": "../../packages/modules/identity" }
  ]
}
