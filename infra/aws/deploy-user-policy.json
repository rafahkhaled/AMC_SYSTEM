{
  "_comment": [
    "ACCOUNT_ID is substituted before this is used. It is left as a placeholder",
    "because this repository is public, and an account number published beside a",
    "description of what runs in it is a starting point somebody does not have to",
    "find for themselves.",
    "",
    "  aws iam put-user-policy --user-name amc-deploy --policy-name amc-deploy \\",
    "    --policy-document \"$(sed s/ACCOUNT_ID/$(aws sts get-caller-identity --query Account --output text)/g infra/aws/deploy-user-policy.json)\""
  ],
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DocumentAndBackupBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:GetBucketLocation",
        "s3:ListAllMyBuckets",
        "s3:ListBucket",
        "s3:PutBucketPublicAccessBlock",
        "s3:GetBucketPublicAccessBlock",
        "s3:PutEncryptionConfiguration",
        "s3:GetEncryptionConfiguration",
        "s3:PutBucketVersioning",
        "s3:GetBucketVersioning",
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "*"
    },
    {
      "Sid": "OnlyRolesNamedAmc",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:TagRole",
        "iam:CreateInstanceProfile",
        "iam:GetInstanceProfile",
        "iam:AddRoleToInstanceProfile"
      ],
      "Resource": [
        "arn:aws:iam::ACCOUNT_ID:role/amc-*",
        "arn:aws:iam::ACCOUNT_ID:instance-profile/amc-*"
      ]
    },
    {
      "Sid": "PassOnlyTheInstanceRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/amc-instance"
    },
    {
      "Sid": "TheInstanceAndItsAddress",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ec2:CreateSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:CreateKeyPair",
        "ec2:RunInstances",
        "ec2:CreateTags",
        "ec2:AllocateAddress",
        "ec2:AssociateAddress",
        "ec2:ModifyInstanceMetadataOptions",
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:RebootInstances"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LookingUpTheUbuntuImage",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:GetParameters"],
      "Resource": "arn:aws:ssm:*::parameter/aws/service/*"
    },
    {
      "Sid": "NotificationEmail",
      "Effect": "Allow",
      "Action": [
        "ses:SendEmail",
        "ses:SendRawEmail",
        "sesv2:CreateEmailIdentity",
        "sesv2:GetEmailIdentity",
        "sesv2:ListEmailIdentities",
        "sesv2:GetAccount"
      ],
      "Resource": "*"
    },
    {
      "Sid": "IsTheRegionOnYet",
      "Effect": "Allow",
      "Action": ["account:GetRegionOptStatus", "account:ListRegions"],
      "Resource": "*"
    }
  ]
}
