# Copy to .env for local development. Never commit a real .env
NODE_ENV=development

# API
PORT=3000
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12

# Database. Port 5433 keeps this cluster clear of any other Postgres on the
# machine. See the README for running it with or without Docker.
DATABASE_URL=postgres://amc@127.0.0.1:5433/amc
TEST_DATABASE_URL=postgres://amc@127.0.0.1:5433/amc_test

# Redis, for the job queue
REDIS_URL=redis://localhost:6379

# Object storage. MinIO locally, S3 in me-central-1 in production
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=amc-documents
S3_REGION=me-central-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Seals two-factor secrets at rest, and later the EmaraTax vault.
# Generate with: openssl rand -base64 32
# Required in production. Outside production a fixed development key is used.
SECRET_ENCRYPTION_KEY=

# Vault master key. In production this is a KMS key id and the master key
# never reaches the process; only single-use data keys do.
VAULT_KMS_KEY_ID=

# AI extraction
ANTHROPIC_API_KEY=
EXTRACTION_CONFIDENCE_THRESHOLD=90
AI_MONTHLY_COST_CAP_AED=500

# Email
SES_REGION=me-central-1
MAIL_FROM=

# Worker
WORKER_NAME=
WORKER_BATCH_SIZE=10
# A lease must outlast the slowest job, or work still running is handed to a
# second worker. Invoice extraction is the slow one.
WORKER_LEASE_SECONDS=300
WORKER_IDLE_MILLISECONDS=1000
OUTBOX_BATCH_SIZE=50

# Business rules
BUSINESS_TIME_ZONE=Asia/Dubai
DEFAULT_CURRENCY=AED

# WhatsApp, through Meta's Cloud API (PW-07).
#
# Leave the driver as `log` until the business account is approved: it
# exercises the whole path — composed, stored, queued, given an id, marked
# sent — and writes the message to the log instead of to a phone.
#
# `cloud` requires all four of the values below and the server refuses to boot
# without them, because the alternative is a practice that believes WhatsApp
# is live while every reply fails somewhere nobody is looking.
WHATSAPP_DRIVER=log
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# The app secret signs every webhook delivery. Without it they are all refused.
# WHATSAPP_APP_SECRET=
# Any string you choose; Meta echoes it back during the subscription handshake.
# WHATSAPP_VERIFY_TOKEN=
